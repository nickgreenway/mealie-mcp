# Mealie MCP Server Configuration
# Copy this file to .env and fill in your values

# Mealie instance URL (no trailing slash)
MEALIE_URL=https://your-mealie-instance.com

# API token from Mealie (User Settings > API Tokens)
MEALIE_API_TOKEN=your-api-token-here

# ---------------------------------------------------------------------------
# Tool mode (optional) — default is "full" (all tools registered, unchanged).
# ---------------------------------------------------------------------------
# "safe" unregisters destructive tools (delete/merge/clear) and external-effect
# tools (webhooks, recipe actions, share-link creation) so they are never
# advertised. Recommended for remote/mobile exposure.
# MEALIE_MCP_MODE=full
#
# Optional: comma-separated extra tool names to also remove in safe mode.
# MEALIE_MCP_SAFE_EXTRA_DENY=
