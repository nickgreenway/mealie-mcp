# Mealie MCP Server Configuration
# Copy this file to .env and fill in your values

# Mealie instance URL (no trailing slash)
MEALIE_URL=https://your-mealie-instance.com

# API token from Mealie (User Settings > API Tokens)
MEALIE_API_TOKEN=your-api-token-here

# ---------------------------------------------------------------------------
# Transport (optional) — defaults preserve the original stdio behavior.
# ---------------------------------------------------------------------------
# stdio (default) for Claude Desktop / Claude Code, or http for remote access.
# MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp
#
# WARNING: exposing the http transport to an untrusted network without an
# auth gate is unsafe. See MCP_SECRET_PATH / MCP_BEARER_TOKEN.
