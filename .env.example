# Mealie MCP Server Configuration
# Copy this file to .env and fill in your values

# Mealie instance URL (no trailing slash)
MEALIE_URL=https://your-mealie-instance.com

# API token from Mealie (User Settings > API Tokens)
MEALIE_API_TOKEN=your-api-token-here

# ---------------------------------------------------------------------------
# Transport (optional) — defaults preserve the original stdio behavior.
# ---------------------------------------------------------------------------
# stdio (default) for Claude Desktop / Claude Code, or http for remote access.
# MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp
#
# WARNING: exposing the http transport to an untrusted network without an
# auth gate is unsafe. See MCP_SECRET_PATH / MCP_BEARER_TOKEN below.

# ---------------------------------------------------------------------------
# Auth gate (optional, http transport only) — both gates are opt-in.
# ---------------------------------------------------------------------------
# Primary gate: mount the MCP endpoint under a secret URL path segment, so the
# full path becomes /<secret>/mcp. Any other path returns 404. Works with
# clients that only let you configure a URL (e.g. Claude custom connectors).
# Generate with: openssl rand -hex 24
# MCP_SECRET_PATH=change-me-to-a-long-random-string
#
# Optional second gate: require Authorization: Bearer <token> on every request
# (the /health probe is exempt). Leave unset to rely on the secret path alone.
# MCP_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Tool mode (optional) — default is "full" (all tools registered, unchanged).
# ---------------------------------------------------------------------------
# "safe" unregisters destructive tools (delete/merge/clear) and external-effect
# tools (webhooks, recipe actions, share-link creation) so they are never
# advertised. Recommended for remote/mobile exposure.
# MEALIE_MCP_MODE=full
#
# Optional: comma-separated extra tool names to also remove in safe mode.
# MEALIE_MCP_SAFE_EXTRA_DENY=
